# Local development
PORT=4000

# Frontend API URL (optional for local development)
VITE_API_URL=http://localhost:4000/api

# PostgreSQL connection for the production database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rydex?schema=public"

# Add payment gateway credentials only on your local machine / hosting secrets.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Maps browser key (restrict by allowed web domains)
# Enable Maps JavaScript API, Places API (New), and Routes API in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=

# Server-side Routes API key. Keep this secret; do not expose it to the browser.
GOOGLE_MAPS_SERVER_API_KEY=

# Local-only OTP testing. Set false/omit in production.
OTP_DEMO_MODE=true
