{
  "name": "hpsv-ai-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Shared platform for SoulNest and Veyra AI",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "veyra:start": "node scripts/start-veyra.mjs",
    "veyra:dev": "node scripts/start-veyra.mjs --dev",
    "soulnest:start": "node scripts/start-soulnest.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.33"
    },
    "@expo/fingerprint": {
      "minimatch": "11.0.1"
    },
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
