{
  "cli": { "version": ">=16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal" },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "environment": "preview"
    },
    "ios-simulator": {
      "distribution": "internal",
      "ios": { "simulator": true },
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "environment": "production"
    }
  },
  "submit": { "production": {} }
}
