# SoulNest local configuration. Never fill secrets in this committed example.
NODE_ENV=development
PORT=4000
PUBLIC_ORIGIN=http://localhost:3000
# Omit DATABASE_URL locally to use persistent embedded PostgreSQL.
DATABASE_URL=
SOULNEST_DATA_DIR=./.soulnest-data
# Next reads SOULNEST_API_ORIGIN when built; use apps/companion-web/.env.local locally.
SOULNEST_API_ORIGIN=http://127.0.0.1:4000
AI_PROVIDER=preview
AI_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=
AI_CHAT_MODEL=
AI_MODERATION_MODEL=omni-moderation-latest
AI_STT_MODEL=
AI_TTS_MODEL=
FREE_DAILY_MESSAGES=30
FREE_DAILY_VOICE=5
# Kept for other shared platform integrations; not active in SoulNest.
REDIS_URL=
SESSION_SECRET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Private mobile photo uploads. Production uploads require S3.
PHOTO_STORAGE=local
OBJECT_STORAGE_REGION=us-east-1

# Account email, configured only on the API. Never expose keys in EXPO_PUBLIC_*.
SOULNEST_EMAIL_PROVIDER=resend
SOULNEST_EMAIL_API_KEY=
SOULNEST_EMAIL_FROM=
SOULNEST_SUPPORT_EMAIL=
# Set only after verifying the exact reverse-proxy chain in your deployment.
SOULNEST_TRUST_PROXY_HOPS=0
FREE_COMPANIONS=3
PREMIUM_COMPANIONS=10
PREMIUM_DAILY_MESSAGES=300
PREMIUM_DAILY_VOICE=50
