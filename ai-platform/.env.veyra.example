# Copy to .env.veyra; the launcher reads it. Never commit real credentials.
# Local development: npm run veyra:dev from ai-platform
PORT=3001
VEYRA_PUBLIC_ORIGIN=http://localhost:3001
# PostgreSQL required with NODE_ENV=production. Empty means local PGlite in development.
VEYRA_DATABASE_URL=
VEYRA_DATA_DIR=./.veyra-data
# Local preview uses scripted replies; choose openai only with live credentials.
VEYRA_AI_PROVIDER=preview
VEYRA_AI_API_KEY=
VEYRA_AI_MODEL=
VEYRA_AI_BASE_URL=https://api.openai.com/v1
VEYRA_MODERATION_MODEL=omni-moderation-latest
VEYRA_FREE_DAILY_MESSAGES=20
VEYRA_PREMIUM_DAILY_MESSAGES=200
# In production set a public HTTPS origin and all age-provider gateway settings.
# No identity documents or birth dates are stored in Veyra.
VEYRA_AGE_MODE=development-attestation
VEYRA_AGE_START_URL=
VEYRA_AGE_API_KEY=
VEYRA_AGE_WEBHOOK_SECRET=
VEYRA_AGE_REDIRECT_HOSTS=
# Production uploads require private S3 with every Public Access Block enabled.
VEYRA_MEDIA_STORAGE=
VEYRA_STORAGE_BUCKET=
VEYRA_STORAGE_REGION=us-east-1
VEYRA_STORAGE_ACCESS_KEY=
VEYRA_STORAGE_SECRET_KEY=
