generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PAYMENT_PENDING
  CONFIRMED
  DRIVER_ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}

model User {
  id        String    @id @default(cuid())
  phone     String    @unique
  name      String?
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

enum PartnerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model PartnerApplication {
  id              String                  @id @default(cuid())
  companyName     String
  contactName     String
  email           String
  phone           String?
  website         String?
  cities          String[]                @default([])
  rideTypes       String[]                @default([])
  integrationType String                  @default("BOOKING_LINK")
  notes           String?
  status          PartnerApplicationStatus @default(PENDING)
  providerCode    String?
  onboardingStep  String                  @default("APPLICATION")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  partnerPassword String?
  @@index([status])
  @@index([createdAt])
}

model Provider {
  id          String   @id @default(cuid())
  name            String
  code            String   @unique
  active          Boolean  @default(true)
  integrationType String   @default("DEMO")
  bookingUrl      String?
  cities          String[] @default([])
  rideTypes       String[] @default([])
  createdAt       DateTime @default(now())
  bookings    Booking[]
  drivers     Driver[]
}

model Driver {
  id            String   @id @default(cuid())
  providerId    String?
  phone         String   @unique
  name          String
  vehicleType   String
  vehicleNumber String?
  available     Boolean  @default(true)
  latitude      Float?
  longitude     Float?
  locationAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  provider Provider? @relation(fields: [providerId], references: [id])
  bookings Booking[]

  @@index([providerId])
  @@index([available])
}

model Booking {
  id             String        @id @default(cuid())
  userId         String?
  providerId     String?
  driverId       String?
  pickup         String
  pickupLat      Float?
  pickupLng      Float?
  destination    String
  destinationLat Float?
  destinationLng Float?
  distanceKm     Float?
  durationMin    Int?
  rideType       String
  rideName       String
  fare           Int
  platformFee    Int           @default(8)
  total          Int
  currency       String        @default("INR")
  status         BookingStatus @default(PAYMENT_PENDING)
  paymentId      String?
  providerRideId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user     User?     @relation(fields: [userId], references: [id])
  provider Provider? @relation(fields: [providerId], references: [id])
  driver   Driver?   @relation(fields: [driverId], references: [id])
  payment  Payment?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id              String   @id @default(cuid())
  bookingId       String   @unique
  gateway         String
  gatewayOrderId  String?
  gatewayPaymentId String?
  amount          Int
  currency        String  @default("INR")
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  booking         Booking  @relation(fields: [bookingId], references: [id])
}

model AnalyticsEvent {
  id           String   @id @default(cuid())
  eventType    String
  providerCode String?
  rideType     String?
  pickup       String?
  destination  String?
  city         String?
  sessionKey   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([providerCode, createdAt])
  @@index([rideType, createdAt])
  @@index([city, createdAt])
}


model ProviderConnection {
  id             String   @id @default(cuid())
  providerId     String   @unique
  apiBaseUrl     String?
  apiKey         String?
  apiSecret      String?
  status         String   @default("NOT_CONFIGURED")
  lastTestedAt   DateTime?
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}


model PartnerSession {
  id            String   @id @default(cuid())
  applicationId String
  token         String   @unique
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([applicationId])
  @@index([expiresAt])
}
